# Public site URL (used for Open Graph absolute URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sanity (project ID is public / safe to commit in client env)
NEXT_PUBLIC_SANITY_PROJECT_ID=k8clerei
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# Editor token from Sanity Manage → API → Tokens (for npm run seed:sanity only)
SANITY_API_WRITE_TOKEN=

# Contact form — Telegram notify (option A)
TELEGRAM_BOT_TOKEN=
# One or many chat IDs (comma-separated)
TELEGRAM_CHAT_IDS=
# Legacy single-id support still works:
TELEGRAM_CHAT_ID=

# Optional email delivery via Resend
RESEND_API_KEY=
CONTACT_FROM_EMAIL=Taologos <onboarding@resend.dev>
CONTACT_NOTIFY_EMAIL=

# One-time browser seed (Vercel): open /api/seed?secret=...
# Create random string; remove after seeding
SEED_SECRET=

# /edit login sessions (signed cookie). Temporary default in code if unset:
# "Taologos General Contractor" — change this in Vercel when you can.
EDIT_SESSION_SECRET=Taologos General Contractor

# How long /edit stays signed in (seconds). Default: 604800 = 7 days (decision 6C)
EDIT_SESSION_MAX_AGE_SECONDS=604800
