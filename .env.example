# Public site URL (used for Open Graph absolute URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public site / Sanity (create project at https://www.sanity.io/manage)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# Contact form — Telegram notify (option A, preferred for company alerts)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional email delivery via Resend
RESEND_API_KEY=
CONTACT_FROM_EMAIL=Taologos <onboarding@resend.dev>
# Optional company inbox if Telegram is unavailable (Resend required)
CONTACT_NOTIFY_EMAIL=
